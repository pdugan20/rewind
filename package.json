{
  "name": "rewind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": "11.5.2"
  },
  "packageManager": "npm@11.5.2",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "npm run db:migrate && wrangler dev",
    "deploy": "npm run deployment:check && npm run db:migrate && npm run db:remote && npm run deploy:worker",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:claude": "claudelint",
    "lint:deps": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:automation-policy": "node --test scripts/automation-policy.test.mjs scripts/deploy-checkpoint.test.mjs scripts/deploy-impact.test.mjs scripts/deploy-range.test.mjs scripts/deploy-worker.test.mjs",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply rewind-db --local",
    "db:remote": "wrangler d1 migrations apply rewind-db --remote",
    "db:studio": "drizzle-kit studio",
    "spec:update": "vitest run src/__tests__/openapi-snapshot.test.ts --update",
    "snapshots:check": "vitest run src/__tests__/openapi-snapshot.test.ts && cd mcp-server && vitest run src/__tests__/manifest-snapshot.test.ts",
    "lint:api": "spectral lint openapi.snapshot.json",
    "www:dev": "cd docs-site && npx astro dev",
    "www:build": "cd docs-site && npx astro build && node ../scripts/check-policy-build.mjs",
    "www:deploy": "cd docs-site && npx astro build && npx wrangler pages deploy dist --project-name rewind-www --commit-dirty=true",
    "docs:dev": "cd docs-mintlify && mint dev",
    "docs:validate": "cd docs-mintlify && mint validate",
    "docs:links": "cd docs-mintlify && mint broken-links --check-anchors --check-redirects",
    "docs:gen-mcp": "tsx scripts/gen-mcp-reference.ts",
    "prepare": "husky",
    "test:cd-artwork": "vitest run -c vitest.cd-artwork.config.ts && node --test scripts/cd-artwork/pipeline.test.mjs scripts/cd-artwork/build.test.mjs",
    "build:cd-artwork": "wrangler deploy -c wrangler.cd-artwork.jsonc --dry-run",
    "docs:check": "node scripts/check-docs.mjs && tsx scripts/gen-mcp-reference.ts --check",
    "test:docs": "node --import tsx --test scripts/check-docs.test.mjs scripts/apex-routing.test.mjs",
    "deploy:worker": "node scripts/deploy-worker.mjs root",
    "deploy:artwork": "node scripts/deploy-worker.mjs artwork",
    "deployment:source-check": "node scripts/deploy-worker.mjs root --source-check",
    "deployment:check": "node scripts/deploy-worker.mjs root --check && node scripts/deploy-worker.mjs artwork --check"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdugan20/rewind.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pdugan20/rewind/issues"
  },
  "homepage": "https://github.com/pdugan20/rewind#readme",
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@hono/zod-validator": "^0.9.0",
    "@jsquash/webp": "^1.5.0",
    "drizzle-orm": "^0.45.1",
    "fast-png": "^8.0.0",
    "hono": "^4.13.2",
    "jpeg-js": "^0.4.4",
    "thumbhash": "^0.1.1",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@eslint/js": "^10.0.1",
    "@mozilla/readability": "^0.6.0",
    "@stoplight/spectral-cli": "^6.16.2",
    "@types/jsdom": "^28.0.1",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "claude-code-lint": "0.7.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-drizzle": "^0.2.3",
    "fit-file-parser": "^2.3.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "lint-staged": "^16.3.3",
    "mint": "4.2.976",
    "prettier": "^3.8.1",
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "~4.1.0",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "qs": "6.16.0",
    "undici": "7.30.0",
    "ws": "8.21.3",
    "sharp": "0.35.5",
    "adm-zip": "0.6.1",
    "axios": "1.20.0",
    "js-yaml@^4.0.0": "4.3.2",
    "fflate": "0.8.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod@>=4 <5": "4.6.7"
  }
}
